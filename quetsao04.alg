algoritmo "CompraDeCarro"

var
Cor: caractere
potencia: inteiro
fabricante: caractere
Caixa: inteiro




inicio

escreval("Qual a cor do carro?")
leia(Cor)
escreval("Qual a potência do carro?")
leia(potencia)
escreval("Qual o fabricante do carro?")
leia(fabricante)
escreval("Qual o valor de investimento disponivel?")
leia(Caixa)

se cor = "Azul" e potencia = 1.8 e fabricante = "Ford" e Caixa >= 40000 então
escreval("Encontramos o carro desejado.") senao escreval("Não encontramos o carro desejado.")
fimse





fimalgoritmo